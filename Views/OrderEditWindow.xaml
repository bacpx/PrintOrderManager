<Window x:Class="PrintOrderManager.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Chỉnh Sửa Đơn Hàng" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Order Info -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <DatePicker Grid.Column="0" SelectedDate="{Binding CurrentOrder.OrderDate}" Width="150" Margin="0,0,16,0" materialDesign:HintAssist.Hint="Ngày đặt hàng" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
            <TextBox Grid.Column="1" Text="{Binding CurrentOrder.Note, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Ghi chú chung" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
        </Grid>

        <!-- Items Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Command="{Binding AddItemCommand}" Content="Thêm dòng" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem, ElementName=ItemsDataGrid}" Content="Xóa dòng" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Red" BorderBrush="Red"/>
        </StackPanel>

        <!-- Items DataGrid -->
        <DataGrid Grid.Row="2" x:Name="ItemsDataGrid"
                  ItemsSource="{Binding Items}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  materialDesign:DataGridAssist.CellPadding="8 4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Kích thước" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                
                <DataGridTemplateColumn Header="Chất liệu" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Material.Name}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Materials, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Gia công" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Process.Name}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Processes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding ProcessId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="1.2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightAlignment}"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat={}{0:N0}}" IsReadOnly="True" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnRightAlignment}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tổng tiền:" FontWeight="Bold" FontSize="16" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding CurrentOrder.TotalAmount, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Hủy" Click="BtnCancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                <Button Command="{Binding SaveCommand}" Content="Lưu Đơn Hàng" Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
